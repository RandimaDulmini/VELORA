# Supabase Project Settings > API. The publishable key is safe to expose; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical URL. Set to your HTTPS Vercel domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: real business contact details. Leave blank to hide contact links.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SUPPORT_EMAIL=
